{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "wesl",
      "camelcase": "Wesl",
      "scope": "source.wesl",
      "path": ".",
      "file-types": [
        "wgsl",
        "wesl"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^w[ge]sl$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "WESL (WGSL Extended) grammar for tree-sitter",
    "authors": [
      {
        "name": "Mathis Brossier",
        "email": "mathis.brossier@gmail.com"
      }
    ],
    "links": {
      "repository": "https://webgpu-tools/tree-sitter-wesl"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
